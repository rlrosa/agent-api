# ==============================================================================
# Agent API Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED VARIABLES
# At least one of API_KEY or API_KEYS must be set.
# ------------------------------------------------------------------------------

# Primary API key used for X-API-Key header authentication (Default key name: 'default').
API_KEY=replace-with-your-secure-random-api-key-here

# Named API key mapping format: "name1:key1,name2:key2". Logs record key name only, never raw secret keys.
API_KEYS=


# ------------------------------------------------------------------------------
# OPTIONAL VARIABLES (with impact comments)
# ------------------------------------------------------------------------------

# IP interface host binding. Default: 0.0.0.0 (listens on all network interfaces).
HOST=0.0.0.0

# HTTP server port. Default: 8090.
PORT=8090

# Comma-separated CIDR subnets allowed to bypass API key auth for read-only status & job execution calls. Default: 127.0.0.1/32,::1/128,127.0.0.0/8,192.168.87.0/24,100.64.0.0/10.
TRUSTED_NETWORKS=127.0.0.1/32,::1/128,127.0.0.0/8,192.168.87.0/24,100.64.0.0/10

# Maximum parallel CLI agent execution workers. Default: 3.
MAX_CONCURRENCY=3

# Maximum execution duration in seconds for a single job before process SIGKILL termination. Default: 120.
JOB_TIMEOUT=120

# Default synchronous wait timeout in seconds when wait parameter is omitted in POST /v1/jobs. Default: 60.
WAIT_DEFAULT=60

# Maximum allowed synchronous wait timeout in seconds for POST /v1/jobs. Default: 90.
WAIT_MAX=90

# File path for primary SQLite jobs database file. Default: ./data/jobs.db.
DB_PATH=./data/jobs.db

# Root directory path for ephemeral job execution workspaces. Default: /var/tmp/agent-api/jobs.
WORK_ROOT=/var/tmp/agent-api/jobs

# Base backoff delay in seconds for AIMD rate-limit retries. Default: 5.0.
BACKOFF_BASE=5.0

# Maximum backoff cap in seconds for AIMD rate-limit retries. Default: 300.0.
BACKOFF_MAX=300.0

# Maximum retry attempts for jobs failing with rate-limit errors (429). Default: 5.
MAX_ATTEMPTS=5

# Maximum allowed byte size per single attachment download (25MB default = 26214400). Default: 26214400.
MAX_ATTACHMENT_BYTES=26214400

# Maximum total aggregate byte size for all attachments in a single job (90MB default = 94371840). Default: 94371840.
MAX_TOTAL_BYTES=94371840

# Comma-separated host or host:port allowlist for attachment URL downloads (empty = allow all public non-SSRF URLs).
ATTACHMENT_HOST_ALLOWLIST=

# Default model override for agy agent calls (e.g. gemini-3.6-flash). Default: empty (uses agent binary default).
AGY_DEFAULT_MODEL=

# Default model override for claude agent calls. Default: empty (uses agent binary default).
CLAUDE_DEFAULT_MODEL=

# Default agent used when POST /v1/jobs payload omits the agent parameter. Default: agy.
DEFAULT_AGENT=agy

# Comma-separated environment variable names passed into agent subprocesses. Default: empty.
PASSTHROUGH_ENV=

# Retain temporary workspace folder on job failure if set to 1. Default: 0 (workspace auto-deleted).
KEEP_WORKSPACE_ON_FAILURE=0

# Enable agent sandbox flags if set to 1. Default: 1.
SANDBOX_ENABLED=1

# Command-line sandbox flags passed to agy agent. Default: --sandbox.
AGY_SANDBOX_FLAGS=--sandbox

# Comma-separated disallowed tools for claude agent. Default: Bash,WebFetch.
CLAUDE_DISALLOWED_TOOLS=Bash,WebFetch

# Consecutive successful jobs required before AIMD increases effective concurrency. Default: 3.
RECOVER_SUCCESSES=3

# Enable mock agent execution for testing if set to 1. Default: 0.
ALLOW_MOCK_AGENT=0

# Enable bubblewrap (bwrap) sandbox confinement if set to 1. Default: 1.
BWRAP_ENABLED=1

# Permitted to run unconfined if bwrap is missing if set to 1. Default: 0 (fail-closed refusal).
ALLOW_UNCONFINED=0

# Restrict outbound egress network calls if set to 1. Default: 0 (unrestricted outbound access).
EGRESS_RESTRICT=0

# Maximum sliding-window requests per minute per caller. Default: 60.
RATE_LIMIT_PER_MIN=60

# Maximum pending jobs allowed in queue before rejecting with HTTP 429. Default: 100.
MAX_PENDING_JOBS=100

# Service log verbosity (DEBUG, INFO, WARNING, ERROR). Default: INFO.
LOG_LEVEL=INFO

# Truncation limit for prompt characters in submission log lines (0 disables truncation). Default: 200.
LOG_PROMPT_CHARS=200

# Retention window in days for automatic purging of old completed/failed jobs (e.g. 30d or 30). Default: 30d.
JOB_RETENTION=30d
