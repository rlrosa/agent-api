FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Ensure UID/GID 1000 exists and matches host user home path expectations
ARG HOST_USER=rrosa
ARG HOST_UID=1000
ARG HOST_GID=1000

RUN if getent passwd ${HOST_UID} >/dev/null; then \
        existing_user=$(getent passwd ${HOST_UID} | cut -d: -f1); \
        usermod -l ${HOST_USER} -d /home/${HOST_USER} -m ${existing_user} || true; \
    else \
        groupadd -g ${HOST_GID} ${HOST_USER} || true; \
        useradd -m -u ${HOST_UID} -g ${HOST_GID} -s /bin/bash ${HOST_USER}; \
    fi && \
    mkdir -p \
        /home/${HOST_USER}/.gemini/antigravity-cli/brain \
        /home/${HOST_USER}/.gemini/antigravity-cli/conversations \
        /home/${HOST_USER}/.gemini/antigravity-cli/cache \
        /home/${HOST_USER}/.gemini/antigravity-cli/log \
        /home/${HOST_USER}/.gemini/config \
        /home/${HOST_USER}/.claude \
        /var/tmp/agent-api/jobs \
        /var/tmp/agent-api/sessions && \
    chown -R ${HOST_UID}:${HOST_GID} /home/${HOST_USER} /var/tmp/agent-api

USER ${HOST_USER}
WORKDIR /home/${HOST_USER}
ENV HOME=/home/${HOST_USER}
ENV PATH="/usr/local/bin:/home/${HOST_USER}/.local/bin:${PATH}"
ENV SSH_CONNECTION=1

# Install Antigravity CLI (agy) and Claude Code (claude) via official install scripts
RUN (curl -fsSL https://antigravity.google/cli/install.sh | bash || true) && \
    (curl -fsSL https://claude.ai/install.sh | bash || true)

USER root
RUN if [ -x "/home/${HOST_USER}/.local/bin/agy" ]; then \
        cp -L "/home/${HOST_USER}/.local/bin/agy" /usr/local/bin/agy && \
        chmod 0755 /usr/local/bin/agy; \
    fi && \
    if [ -x "/home/${HOST_USER}/.local/bin/claude" ]; then \
        cp -L "/home/${HOST_USER}/.local/bin/claude" /usr/local/bin/claude && \
        chmod 0755 /usr/local/bin/claude; \
    fi

USER ${HOST_USER}
WORKDIR /var/tmp/agent-api/jobs
